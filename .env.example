# Finco1 — Environment Variables Example
# Copy this file to .env and fill in production values.
# DO NOT commit .env files with real secrets to version control.

# ─── Application Mode ───────────────────────────────────────────────────────────
# Allowed values: development, internal, pilot
# - development: allows placeholder/dev credentials with warnings
# - internal: same as development; single-user internal use
# - pilot: REQUIRES real secrets; fails fast on placeholder/insecure values
# FINCO_APP_MODE=development

# ─── Application ────────────────────────────────────────────────────────────────
# Secret signing key — REQUIRED in production/pilot mode.
# In development mode, a WARNING is printed if this is unset.
# FINCO_SECRET_KEY=changeme-dev-only-not-for-pilot

# Admin credentials — REQUIRED in production/pilot mode.
# FINCO_ADMIN_USER=admin
# FINCO_ADMIN_PASSWORD=changeme-dev-only-not-for-pilot
# FINCO_ADMIN_PASSWORD_HASH=  # Leave empty to use FINCO_ADMIN_PASSWORD; set bcrypt hash to override

# Session TTL in hours (default: 24)
# FINCO_SESSION_HOURS=24

# Cookie security — set to false only for local HTTP development.
# FINCO_COOKIE_SECURE=true

# Cookie SameSite policy (default: lax)
# FINCO_COOKIE_SAMESITE=lax

# CSRF secret — leave empty to use FINCO_SECRET_KEY
# FINCO_CSRF_SECRET=

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite database path (default: app/data/finco_runs.db)
# FINCO_DB_PATH=app/data/finco_runs.db

# ─── Backup ───────────────────────────────────────────────────────────────────────
# Backup directory (default: app/data/backups/sqlite)
# FINCO_BACKUP_DIR=app/data/backups/sqlite

# ─── Development ───────────────────────────────────────────────────────────────
# WARNING: DEBUG mode is for local development only.
# Never enable DEBUG in production or publicly accessible deployments.
# DEBUG=false
