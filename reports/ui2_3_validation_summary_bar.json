  "bar_spec": {
    "context_handling": {
      "validation_summary_supplied": "render counts/status from it (pass/warn/fail counts + last_validated_at)",
      "validation_summary_missing": "render compact neutral info bar with safe internal-review message"
    },
    "tones": 4,
    "tones_list": [
      "pass",
      "warn",
      "fail",
      "info"
    ],
    "tone_triggers": {
      "pass": "0 fail, 0 warn",
      "warn": ">= 1 warn, 0 fail",
      "fail": ">= 1 fail",
      "info": "validation_summary missing"
    },
    "html_structure": "<div class=\"validation-summary-bar validation-summary-{tone}\" role=\"status\"><span class=\"validation-summary-icon\">VS</span><div class=\"validation-summary-body\"><span class=\"validation-summary-title\">{label}</span><span class=\"validation-summary-desc\">{description}</span></div>{if last_validated_at}<span class=\"validation-summary-meta\">{timestamp}</span>{endif}</div>"
  },
  "behavior": {
    "compact_size": "smaller than UI-2.1 banner (0.65rem padding vs 0.75rem)",
    "always_renders": true,
    "no_financial_logic": true,
    "no_external_validation_claim": true,
    "optional_last_validated_at": "shown on right side when validation_summary is supplied"
