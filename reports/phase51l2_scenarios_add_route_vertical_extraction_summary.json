  "extraction_rationale": {
    "why_new_module_not_scenario_state_service": "scenario_state_service.py is data-layer only (no Request, no form, no auth).",
    "why_new_module_not_scenario_state_route_service": "scenario_state_route_service.py handles workspace draft/discard mutations WITHOUT scenario row creation. Add creates a new ScenarioRecord; different concern.",
    "why_new_module_not_scenarios_save_service": "scenarios_save_service.py is for /scenarios/save (creates a new ScenarioRecord from form snapshot). Add creates a new non-base scenario with parent inheritance from base case; different concern.",
    "why_new_module_not_scenario_duplicate_service": "scenario_duplicate_service.py is for /scenarios/{id}/duplicate (copies an existing ScenarioRecord). Different concern."
  },
