  },
  "field_shortlist": {
    "vat": {
      "required": [
        "vat_recoverable_flag",
        "vat_rate_pct",
        "vat_basis_mode"
      ],
      "optional": [
        "vat_jurisdiction_code"
      ],
      "future_only": [
        "vat_note"
      ]
    },
    "wht": {
      "required": [
        "wht_rate_pct",
        "wht_treatment_mode",
        "wht_gross_up_flag"
      ],
      "optional": [
        "wht_jurisdiction_code"
      ],
      "future_only": [
        "wht_supplier_reference"
      ]
    },
    "depreciation": {
      "required": [
        "depreciation_asset_class",
        "depreciation_useful_life_years",
        "depreciable_flag",
        "depreciation_basis_mode"
      ],
      "optional": [],
      "future_only": [
        "depreciation_method_code",
        "depreciation_note"
      ]
    }
  },
  "scenario_semantics": {
    "binding_key": "sub_line_id",
    "override_rule": "replace_not_delta",
    "overrideable_fields": [
      "vat_recoverable_flag",
      "vat_rate_pct",
      "vat_basis_mode",
      "wht_rate_pct",
      "wht_treatment_mode",
      "wht_gross_up_flag",
      "depreciation_asset_class",
      "depreciation_useful_life_years",
      "depreciable_flag",
      "depreciation_basis_mode"
    ],
    "non_overrideable_fields_by_default": [
      "vat_jurisdiction_code",
      "wht_jurisdiction_code",
      "vat_note",
      "wht_supplier_reference",
      "depreciation_note"
    ],
    "duplicate_scenario_behavior": "preserve_same_project_level_sub_line_id_references_and_copy_override_payload",
    "deleted_readded_behavior": "new_line_gets_new_sub_line_id_and_stale_override_ids_must_not_rebind"
  },
  "validation_rules": {
    "allowed_ranges": {
      "vat_rate_pct": "0_to_100",
      "wht_rate_pct": "0_to_100",
      "depreciation_useful_life_years": "positive_integer_gt_0"
    },
    "required_combinations": [
      "vat_recoverable_flag_requires_vat_rate_pct_and_vat_basis_mode",
      "wht_rate_pct_requires_wht_treatment_mode_and_wht_gross_up_flag",
      "depreciable_flag_true_requires_asset_class_useful_life_and_basis_mode"
    ],
    "invalid_combinations": [
      "non_depreciable_with_non_empty_useful_life",
      "gross_up_flag_true_with_non_gross_up_treatment_mode",
      "tax_rate_without_basis_mode",
      "unknown_basis_mode_values"
    ]
  },
  "export_authority": {
    "CapEx": "summary_evidence_only",
    "CapEx_Items": "per_line_scalar_evidence_where_useful",
    "CapEx_SubLines_Audit": "canonical_per_line_evidence_surface",
    "Tax_Audit_Sheets": "future_vat_wht_deep_audit_surface",
    "Depreciation_Audit_Sheets": "future_depreciation_deep_audit_surface"
  },
  "generic_compatibility": {
    "supported_project_families": [
